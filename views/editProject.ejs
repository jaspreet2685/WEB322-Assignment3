<!DOCTYPE html>
<html lang="en" data-theme="dim">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Project</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-base-300">
  <%- include('partials/navbar') %>

  <div class="container mx-auto px-4 py-8">
    <!-- Hero Section -->
    <div class="text-center mb-8">
      <h1 class="text-5xl font-bold text-base-content mb-4">Edit Project</h1>
      <p class="text-lg text-base-content/70">
        <%= project.title %>
      </p>
    </div>

    <!-- Edit Project Form -->
    <div class="bg-base-100 rounded-lg shadow-lg p-8 max-w-6xl mx-auto">
      <form method="POST" action="/solutions/editProject">
        
        <!-- Hidden ID Field -->
        <input type="hidden" name="id" value="<%= project.id %>" />

        <!-- Row 1: Title, Feature Image URL, Sector -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <!-- Title -->
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold">Title</span>
            </label>
            <input 
              type="text" 
              name="title" 
              value="<%= project.title %>" 
              class="input input-bordered bg-base-200" 
              required 
            />
          </div>

          <!-- Feature Image URL -->
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold">Feature Image (URL)</span>
            </label>
            <input 
              type="url" 
              name="feature_img_url" 
              value="<%= project.feature_img_url %>" 
              class="input input-bordered bg-base-200" 
              required 
            />
          </div>

          <!-- Sector -->
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold">Sector</span>
            </label>
            <select name="sector_id" class="select select-bordered bg-base-200" required>
              <option value="1" <%= (project.sector_id == 1) ? "selected" : "" %>>Land Sinks</option>
              <option value="2" <%= (project.sector_id == 2) ? "selected" : "" %>>Industry</option>
              <option value="3" <%= (project.sector_id == 3) ? "selected" : "" %>>Transportation</option>
              <option value="4" <%= (project.sector_id == 4) ? "selected" : "" %>>Electricity</option>
              <option value="5" <%= (project.sector_id == 5) ? "selected" : "" %>>Food, Agriculture, and Land Use</option>
            </select>
          </div>
        </div>

        <!-- Row 2: Intro, Short Summary, Impact -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <!-- Intro -->
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold">Intro</span>
            </label>
            <textarea 
              name="intro_short" 
              class="textarea textarea-bordered bg-base-200 h-32" 
              required
            ><%= project.intro_short %></textarea>
          </div>

          <!-- Short Summary -->
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold">Short Summary</span>
            </label>
            <textarea 
              name="summary_short" 
              class="textarea textarea-bordered bg-base-200 h-32" 
              required
            ><%= project.summary_short %></textarea>
          </div>

          <!-- Impact -->
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold">Impact</span>
            </label>
            <textarea 
              name="impact" 
              class="textarea textarea-bordered bg-base-200 h-32" 
              required
            ><%= project.impact %></textarea>
          </div>
        </div>

        <!-- Row 3: Original Source URL (full width) -->
        <div class="form-control mb-6">
          <label class="label">
            <span class="label-text font-semibold">Original Source (URL)</span>
          </label>
          <input 
            type="url" 
            name="original_source_url" 
            value="<%= project.original_source_url %>" 
            class="input input-bordered bg-base-200" 
            required 
          />
        </div>

        <!-- Action Buttons -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <button type="submit" class="btn btn-success text-lg">Update Project</button>
          <a 
            href="/solutions/deleteProject/<%= project.id %>" 
            class="btn btn-error text-lg" 
            onclick="return confirm('Are you sure you want to delete this project?')"
          >
            Delete Project
          </a>
        </div>

      </form>
    </div>
  </div>
</body>
</html>
